{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "src/soul-mesh/**/*.ts",
    "lib/soul-mesh/**/*.ts",
    "lib/soul-core/Nucleus05Capabilities.ts",
    "lib/soul-core/Nucleus05Processor.ts",
    "app/api/soul-mesh/**/*.ts"
  ]
}
