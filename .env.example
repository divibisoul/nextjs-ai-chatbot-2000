# Generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=****

# xAI API key used by the existing chat/AI provider.
XAI_API_KEY=****

# Existing application storage.
BLOB_READ_WRITE_TOKEN=****
POSTGRES_URL=****
REDIS_URL=****

# Soul Mesh authentication. Use the same secret on every nucleus.
# Required in production; never commit a real secret.
SOUL_MESH_TOKEN=****

# Optional model overrides for N06 Mesh cognition.
SOUL_MESH_AI_MODEL=chat-model
SOUL_MESH_REASONING_MODEL=chat-model-reasoning

# Maximum accepted clock skew for inbound Mesh messages (milliseconds).
SOUL_MESH_MAX_CLOCK_SKEW_MS=300000

# Runtime base URLs for the five remote Soul nuclei.
# Do not commit real deployment URLs or secrets here.
SOUL_MESH_N01_URL=
SOUL_MESH_N02_URL=
SOUL_MESH_N03_URL=
SOUL_MESH_N04_URL=
SOUL_MESH_N05_URL=
